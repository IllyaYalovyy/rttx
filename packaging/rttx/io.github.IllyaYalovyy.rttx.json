{
    "app-id": "io.github.IllyaYalovyy.rttx",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "rttx",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/rttx/cargo"
        }
    },
    "modules": [
        {
            "name": "vte",
            "buildsystem": "meson",
            "config-opts": [
                "-Dgtk3=false",
                "-Dgtk4=true",
                "-Ddocs=false",
                "-Dgir=false",
                "-Dglade=false",
                "-Dvapi=false",
                "-Dlibdir=lib"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/vte/0.78/vte-0.78.7.tar.xz",
                    "sha256": "6fd1edc332d9f9519ce4c0f07135fdf72d64dfd990dc4fabc6ce91b1b7e83dd0"
                }
            ]
        },
        {
            "name": "rttx",
            "buildsystem": "meson",
            "sources": [
                "flatpak/cargo-sources.json",
                {
                    "type": "dir",
                    "path": "../../"
                }
            ]
        }
    ]
}
