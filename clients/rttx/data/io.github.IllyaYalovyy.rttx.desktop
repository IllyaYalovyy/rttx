[Desktop Entry]
Name=rttx
Comment=A tiling terminal emulator for GNOME
Exec=rttx
Icon=io.github.IllyaYalovyy.rttx
Terminal=false
Type=Application
Categories=System;TerminalEmulator;
Keywords=terminal;tiling;shell;console;command;
StartupNotify=true
StartupWMClass=io.github.IllyaYalovyy.rttx
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=rttx
